# English Tutor environment variables. Copy to .env and fill in; .env is gitignored.
# On Railway, set the same variables in the service settings instead.

# --- Required -------------------------------------------------------------------------------
# OpenRouter key for every LLM call (not needed with --offline). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Models (optional) ----------------------------------------------------------------------
# OpenRouter model ids ("vendor/model"). Leave empty to use the defaults in src/english_tutor/config.py.
# Pattern: ENGLISH_TUTOR_<ROLE>_MODEL and ENGLISH_TUTOR_<ROLE>_FALLBACK_MODEL ("none" disables the fallback).
# Roles: TEACHER (live chat), EXAMINER, REPORTER, WRITER (the last three are not wired up yet).
ENGLISH_TUTOR_TEACHER_MODEL=
ENGLISH_TUTOR_TEACHER_FALLBACK_MODEL=
ENGLISH_TUTOR_EXAMINER_MODEL=
ENGLISH_TUTOR_REPORTER_MODEL=
ENGLISH_TUTOR_WRITER_MODEL=

# Log level of the english_tutor loggers: DEBUG, INFO, WARNING, ERROR (CLI default WARNING, service INFO).
ENGLISH_TUTOR_LOG_LEVEL=WARNING

# --- Service (python -m english_tutor.api; not needed for `english-tutor chat` or `english-tutor serve`) ---------
# App Postgres (Neon) URL, postgresql://USER:PASSWORD@HOST/neondb?sslmode=require. Use a role
# limited to reading users/teacher_personas/scenarios and writing sessions/messages/ai_usage_logs,
# not the app's owner role. The eval export (python -m english_tutor.evals.db_export) reads it too.
DATABASE_URL=
# One key per caller, each at least 32 characters (openssl rand -hex 32). Sent as X-API-Key.
ENGLISH_TUTOR_BACKEND_API_KEY=
ENGLISH_TUTOR_PIPECAT_API_KEY=
# HS256 secret shared with the app backend, which mints short-lived learner tokens with it.
ENGLISH_TUTOR_TOKEN_SECRET=
# Comma-separated web origins allowed to call the service from the browser.
ENGLISH_TUTOR_CORS_ORIGINS=
# "off" hides /docs and /openapi.json.
ENGLISH_TUTOR_DOCS=on
# Per-learner limits.
ENGLISH_TUTOR_TURNS_PER_MINUTE=20
ENGLISH_TUTOR_SESSIONS_PER_HOUR=30
