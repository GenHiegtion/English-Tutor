# EA-LLM environment variables. Copy to .env and fill in; .env is gitignored.

# --- Required -------------------------------------------------------------------------------
# OpenRouter key for every LLM call (not needed with --offline). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Models (optional) ----------------------------------------------------------------------
# OpenRouter model ids ("vendor/model"). Leave empty to use the defaults in src/ea_llm/config.py.
# Pattern: EA_LLM_<ROLE>_MODEL and EA_LLM_<ROLE>_FALLBACK_MODEL ("none" disables the fallback).
# Roles: TEACHER (live chat), EXAMINER, REPORTER, WRITER (the last three are not wired up yet).
EA_LLM_TEACHER_MODEL=
EA_LLM_TEACHER_FALLBACK_MODEL=
EA_LLM_EXAMINER_MODEL=
EA_LLM_REPORTER_MODEL=
EA_LLM_WRITER_MODEL=

# --- Dev tools (optional) -------------------------------------------------------------------
# Log level of the ea_llm loggers for `ea-llm chat` / `ea-llm serve`: DEBUG, INFO, WARNING, ERROR.
EA_LLM_LOG_LEVEL=WARNING

# Read-only Postgres URL of the Talkwise database, only for the eval export tool
# (python -m ea_llm.evals.talkwise_export). Use a read-only Neon role, never the app's owner role.
TALKWISE_DATABASE_URL=
