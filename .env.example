# EA-LLM environment variables. Copy to .env and fill in; .env is gitignored.
# On Railway, set the same variables in the service settings instead.

# --- Required -------------------------------------------------------------------------------
# OpenRouter key for every LLM call (not needed with --offline). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Models (optional) ----------------------------------------------------------------------
# OpenRouter model ids ("vendor/model"). Leave empty to use the defaults in src/ea_llm/config.py.
# Pattern: EA_LLM_<ROLE>_MODEL and EA_LLM_<ROLE>_FALLBACK_MODEL ("none" disables the fallback).
# Roles: TEACHER (live chat), EXAMINER, REPORTER, WRITER (the last three are not wired up yet).
EA_LLM_TEACHER_MODEL=
EA_LLM_TEACHER_FALLBACK_MODEL=
EA_LLM_EXAMINER_MODEL=
EA_LLM_REPORTER_MODEL=
EA_LLM_WRITER_MODEL=

# Log level of the ea_llm loggers: DEBUG, INFO, WARNING, ERROR (CLI default WARNING, service INFO).
EA_LLM_LOG_LEVEL=WARNING

# --- Service (python -m ea_llm.api; not needed for `ea-llm chat` or `ea-llm serve`) ---------
# Talkwise Postgres (Neon) URL, postgresql://USER:PASSWORD@HOST/neondb?sslmode=require. Use a role
# limited to reading users/teacher_personas/scenarios and writing sessions/messages/ai_usage_logs,
# not the Talkwise owner role. The eval export (python -m ea_llm.evals.talkwise_export) reads it too.
DATABASE_URL=
# One key per caller, each at least 32 characters (openssl rand -hex 32). Sent as X-API-Key.
EA_LLM_TALKWISE_API_KEY=
EA_LLM_PIPECAT_API_KEY=
# HS256 secret shared with the Talkwise backend, which mints short-lived learner tokens with it.
EA_LLM_TOKEN_SECRET=
# Comma-separated web origins allowed to call the service from the browser.
EA_LLM_CORS_ORIGINS=
# "off" hides /docs and /openapi.json.
EA_LLM_DOCS=on
# Per-learner limits.
EA_LLM_TURNS_PER_MINUTE=20
EA_LLM_SESSIONS_PER_HOUR=30
